# ─── OE MES Ortam Değişkenleri ──────────────────────────────────────────────
# Bu dosyayı .env olarak kopyalayın ve değerleri güncelleyin.

# JWT imzalama anahtarı (ZORUNLU) — uzun, rastgele bir değer kullanın
# Örnek üretim: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# OPC UA / PLC kimlik bilgilerinin (kullanıcı şifreleri) DB'de şifreli saklanması için
# AES-256-GCM anahtarı (64 hex karakter = 32 byte). Boş bırakılırsa JWT_SECRET'tan türetilir.
# Örnek üretim: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Sunucu portu (varsayılan: 3000)
PORT=3000

# SQLite veritabanı dosya yolu
# Lokal geliştirme: ./data/mes.db (backend cwd'ye göre)
# Docker: /app/data/mes.db
DB_PATH=./data/mes.db

# Log seviyesi: fatal | error | warn | info | debug | trace
LOG_LEVEL=info